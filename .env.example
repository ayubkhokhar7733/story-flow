# AI Horde API Key
# Use '0000000000' for free anonymous generation without an account.
# If you create an account on aihorde.net, paste your registered API key here for higher priority.
AI_HORDE_API_KEY=0000000000

# Base URL for AI Horde v2 API
AI_HORDE_BASE_URL=https://aihorde.net/api/v2

# Required Client-Agent identifier (format: AppName:Version:Contact)
# Prevents aggressive rate limiting by the AI Horde coordinator.
AI_HORDE_CLIENT_AGENT=StoryFlow:1.0.0:dev@localhost

# Server port for the web dashboard / API
PORT=3000
